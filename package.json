{
  "name": "theaistudybible",
  "description": "The AI Study Bible",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean-install": "rimraf pnpm-lock.yaml --glob '**/node_modules' && pnpm cache delete && pnpm install --recursive",
    "clean": "turbo run clean",
    "cy:open": "cypress open",
    "db:generate": "drizzle-kit generate",
    "db:seed:prod": "tsx ./tools/scripts/src/index.ts db seed",
    "db:seed": "tsx ./tools/scripts/src/index.ts db seed",
    "deploy": "alchemy deploy alchemy.run.ts --stage production",
    "dev": "alchemy dev alchemy.run.ts",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "lint:fix": "biome lint --write .",
    "lint": "biome lint .",
    "prepare": "husky",
    "prerelease": "pnpm run type-check && pnpm run format && pnpm run lint:fix && pnpm run build && pnpm run test",
    "refresh": "alchemy deploy alchemy.run.ts --force",
    "remove": "alchemy destroy alchemy.run.ts",
    "scripts:prod": "tsx ./tools/scripts/src/index.ts",
    "scripts": "tsx ./tools/scripts/src/index.ts",
    "test:e2e": "cypress run",
    "test": "vitest run",
    "type-check": "turbo run type-check",
    "upgrade": "pnpm update -r --latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@types/node": "^26.1.1",
    "@types/web-push": "^3.6.4",
    "alchemy": "^0.93.12",
    "cypress": "^15.18.1",
    "cypress-wait-until": "^3.0.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "why-is-node-running": "^3.2.2",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "ai": "^7.0.31",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "0.8.3",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.13 <26"
  },
  "packageManager": "pnpm@11.15.1"
}
