# Deployed stages read these from GitHub Environment secrets (production, staging,
# preview). Copy to .env for local `pnpm dev` (`alchemy dev`).

# Alchemy and Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Encrypts Alchemy secrets in state
ALCHEMY_PASSWORD=
# Enables the Cloudflare-hosted Alchemy state store (unset locally = local .alchemy state)
ALCHEMY_STATE_TOKEN=

# Application
AI_CONTEXT_SIZE=
DONATION_LINK=

# Authentication (Sign in with Apple, Google OAuth)
APPLE_AUTH_KEY=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Benchmark-approved daily quotas
FREE_CHAT_DAILY_LIMIT=
FREE_IMAGE_DAILY_LIMIT=
FREE_SUGGESTION_DAILY_LIMIT=
PRO_CHAT_DAILY_LIMIT=
PRO_IMAGE_DAILY_LIMIT=
PRO_SUGGESTION_DAILY_LIMIT=

# OpenRouter models
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_EMBEDDING_DIMENSIONS=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_RERANK_MODEL=

# Billing (Pro prices and the webhook endpoint are managed by Alchemy)
STRIPE_SECRET_KEY=

# Web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observability
POSTHOG_API_HOST=
POSTHOG_API_KEY=
SENTRY_DSN=

# Local development only (`alchemy dev`); deployed stages derive these.
# URL where `pnpm dev` serves the web app
WEB_APP_URL=
# Signing secret printed by `stripe listen --forward-to <webhook worker URL>/stripe`
STRIPE_WEBHOOK_SECRET=

# Cypress end-to-end tests (`pnpm test:e2e`); WEB_APP_URL above is the base URL.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
