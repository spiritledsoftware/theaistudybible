{
  "extends": "@theaistudybible/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "verbatimModuleSyntax": false,
    "lib": ["ESNext", "ESNext.AsyncIterable", "DOM", "DOM.Iterable", "WebWorker"],
    "types": [
      "@types/node",
      "@cloudflare/workers-types",
      "vite/client",
      "vite-plugin-pwa/info",
      "vite-plugin-pwa/react"
    ],
    "paths": {
      "@/www": ["./app"],
      "@/www/*": ["./app/*"],
      "@/schemas": ["../../packages/schemas/src"],
      "@/schemas/*": ["../../packages/schemas/src/*"],
      "@/core": ["../../packages/core/src"],
      "@/core/*": ["../../packages/core/src/*"],
      "@/ai": ["../../packages/ai/src"],
      "@/ai/*": ["../../packages/ai/src/*"],
      "@/email": ["../../packages/email/src"],
      "@/email/*": ["../../packages/email/src/*"],
      "@/workers": ["../workers/src"],
      "@/workers/*": ["../workers/src/*"],
      "@/scripts": ["../../tools/scripts/src"],
      "@/scripts/*": ["../../tools/scripts/src/*"]
    }
  },
  "include": ["../../packages/core/globals.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
