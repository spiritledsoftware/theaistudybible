{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.vscode",
      "!**/.turbo",
      "!**/dist",
      "!**/pnpm-lock.yaml",
      "!**/migrations",
      "!**/packages/core/src/utils/bibles/__tests__/MAT.json",
      "!**/apps/www/app/routeTree.gen.ts",
      "!**/apps/www/src"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "warn",
        "noLabelWithoutControl": "warn",
        "useHtmlLang": "off"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "correctness": {
        "useJsxKeyInIterable": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnknownFunction": "warn"
      },
      "nursery": {
        "useSortedClasses": "info"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error",
        "useExportType": "error"
      },
      "suspicious": {
        "useAwait": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true,
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
